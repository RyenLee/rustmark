# 构建产物
/target/
**/*.rs.bk

# 覆盖率生成物（cargo llvm-cov 输出，非源码，勿入库）
lcov.info
*.lcov

# CI/本地验证在仓库根生成的日志与摘要（命令见 .github/workflows/ci.yml）
test-output.log
integration-perf.log
presentation-perf.log
coverage-summary.txt
dryrun-summary.txt

# 本地临时验证目录
.tmp-verify/
# 全量测试用的独立 target（避让正在运行的主程序对 target/ 二进制的占用）
/target-verify/
# UI 截图产出（浏览器验证用，不入库）
.screenshots/
.trae/
deliverables/

# 本地覆盖配置与密钥（严禁入库）
*.local.toml
*.p12
*.pfx
*.cer
*.key
.env

# Python 字节码缓存（运行 tools/ 下脚本时自动生成，删了会自动重建）
__pycache__/
*.pyc

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地运行时/智能体数据（含本机绝对路径，非源码）
.workbuddy/
.agent/

# 发布构建产物（由 release workflow 重新生成，非源码）
/dist/

# CI 安装的 cargo 命令行工具（cargo-deny / llvm-cov / bloat），带缓存
/.cargo-tools/
